{
  "name": "mvola-client",
  "version": "0.3.2",
  "description": "MVola Merchant Pay client for Node.js — native fetch, zero runtime dependencies, safe by default",
  "keywords": [
    "madagascar",
    "merchant-pay",
    "mobile-money",
    "mvola",
    "mvola-api",
    "payment"
  ],
  "license": "MIT",
  "author": "Tsiory Jonathan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TsioryJonathan/mvola-client.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/smoke-test.cjs",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build && npm run test:package"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
