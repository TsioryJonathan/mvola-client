{
  "name": "mvola-client",
  "version": "0.1.0",
  "description": "Modern MVola API client for Node.js — native fetch, zero runtime dependencies",
  "keywords": [
    "madagascar",
    "merchant-pay",
    "mobile-money",
    "mvola",
    "mvola-api",
    "payment"
  ],
  "license": "MIT",
  "author": "Tsiory Jonathan",
  "repository": {
    "type": "git",
    "url": "https://github.com/TsioryJonathan/mvola-client.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
